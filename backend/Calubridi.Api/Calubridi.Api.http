@Calubridi_Api_HostAddress = http://localhost:5228

### Obtener todos los productos
GET {{Calubridi_Api_HostAddress}}/api/products
Accept: application/json

###

### Obtener producto por ID
GET {{Calubridi_Api_HostAddress}}/api/products/6
Accept: application/json

###

### Crear producto sin categoría
POST {{Calubridi_Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Bolso Roma",
  "description": "Bolso confeccionado a pedido",
  "price": 8000,
  "estimatedProductionDays": 5
}

###

### Crear producto con categoría
POST {{Calubridi_Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Vestido Primavera",
  "description": "Vestido confeccionado a pedido",
  "price": 45000,
  "estimatedProductionDays": 7,
  "categoryId": 3
}

###

### Intentar crear producto con categoría inexistente
POST {{Calubridi_Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Producto de prueba",
  "description": "Este producto no debería crearse",
  "price": 10000,
  "estimatedProductionDays": 3,
  "categoryId": 99999
}

### Actualizar producto
PUT {{Calubridi_Api_HostAddress}}/api/products/6
Content-Type: application/json

{
  "name": "Kit desmaquillante",
  "description": "Producto Estrella",
  "price": 20000,
  "estimatedProductionDays": 7,
  "isActive": true
}

###

### Actualizar producto y cambiar categoría
PUT {{Calubridi_Api_HostAddress}}/api/products/6
Content-Type: application/json

{
  "name": "Bolso Roma Premium",
  "description": "Bolso confeccionado a pedido - versión premium",
  "price": 35000,
  "estimatedProductionDays": 6,
  "isActive": true,
  "categoryId": 3
}

### Eliminar producto
DELETE {{Calubridi_Api_HostAddress}}/api/products/6





########





### Subir imagen principal al producto 7
POST {{Calubridi_Api_HostAddress}}/api/products/7/media?isPrimary=true&displayOrder=1
Content-Type: multipart/form-data; boundary=CalubridiBoundary

--CalubridiBoundary
Content-Disposition: form-data; name="file"; filename="producto-prueba.jpg"
Content-Type: image/jpeg

< ./test-files/producto-prueba.jpg
--CalubridiBoundary--


### Eliminar imagen del producto 7
DELETE {{Calubridi_Api_HostAddress}}/api/products/7/media/2


###

### Subir imagen 1 - PRINCIPAL
POST {{Calubridi_Api_HostAddress}}/api/products/7/media?isPrimary=true&displayOrder=1
Content-Type: multipart/form-data; boundary=CalubridiBoundary

--CalubridiBoundary
Content-Disposition: form-data; name="file"; filename="producto-prueba.jpg"
Content-Type: image/jpeg

< ./test-files/producto-prueba.jpg
--CalubridiBoundary--

###

### Subir imagen 2 - SECUNDARIA
POST {{Calubridi_Api_HostAddress}}/api/products/7/media?isPrimary=false&displayOrder=2
Content-Type: multipart/form-data; boundary=CalubridiBoundary

--CalubridiBoundary
Content-Disposition: form-data; name="file"; filename="Prueba2.jpg"
Content-Type: image/jpeg

< ./test-files/Prueba2.jpg
--CalubridiBoundary--

###

### Subir imagen 3 - SECUNDARIA
POST {{Calubridi_Api_HostAddress}}/api/products/7/media?isPrimary=false&displayOrder=3
Content-Type: multipart/form-data; boundary=CalubridiBoundary

--CalubridiBoundary
Content-Disposition: form-data; name="file"; filename="Prueba3.jpg"
Content-Type: image/jpeg

< ./test-files/Prueba3.jpg
--CalubridiBoundary--


### Eliminar imagen principal
DELETE {{Calubridi_Api_HostAddress}}/api/products/7/media/3




#################









### Crear categoría
POST {{Calubridi_Api_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Vestidos",
  "isActive": true
}


### Obtener todas las categorías
GET {{Calubridi_Api_HostAddress}}/api/categories
Accept: application/json

###

### Obtener categoría por ID
GET {{Calubridi_Api_HostAddress}}/api/categories/1
Accept: application/json

###

### Actualizar categoría
PUT {{Calubridi_Api_HostAddress}}/api/categories/1
Content-Type: application/json

{
  "name": "Vestidos y Conjuntos",
  "isActive": true
}

###

### Eliminar categoría
DELETE {{Calubridi_Api_HostAddress}}/api/categories/3